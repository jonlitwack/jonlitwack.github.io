{
  "name": "jonlitwack-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "seed:build": "node scripts/build-seed.mjs",
    "build:cf": "astro build --config astro.config.cloudflare.mjs",
    "deploy": "astro build --config astro.config.cloudflare.mjs && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.2.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@jonlitwack/plugin-chart": "file:plugins/chart",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.3.2",
    "emdash": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "wrangler": "^4.149.0"
  },
  "description": "jonlitwack.com on EmDash"
}
