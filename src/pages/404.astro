---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
// Short, so a slug published after someone hit its 404 shows up quickly.
if (Astro.cache?.enabled) Astro.cache.set({ maxAge: 60 });
---

<Base title="Not found">
	<div class="container essay">
		<h1>Not found</h1>
		<hr />
		<p class="essay-body">That page isn't here. It may have moved when the site did.</p>
		<a href="/" class="back-link">← Essays</a>
	</div>
</Base>
